          "editorMode": "code",
          "expr": "sum by (namespace) (rate(poll_success_sync{namespace!~\"temporal_system|system|_unknown_\"}[$__rate_interval]))\n/ clamp_min(sum by (namespace) (rate(poll_success{namespace!~\"temporal_system|system|_unknown_\"}[$__rate_interval])), 1)",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{namespace}}"
