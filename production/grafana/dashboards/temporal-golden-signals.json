          "editorMode": "code",
          "expr": "sum by (task_queue) (temporal_worker_task_slots_used{namespace!~\"temporal_system|system|_unknown_\"})\n/ clamp_min(\n    sum by (task_queue) (temporal_worker_task_slots_used{namespace!~\"temporal_system|system|_unknown_\"})\n  + sum by (task_queue) (temporal_worker_task_slots_available{namespace!~\"temporal_system|system|_unknown_\"}), 1)",
