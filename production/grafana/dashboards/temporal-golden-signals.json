{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Four golden signals (RED + Saturation) for a self-hosted Temporal Service, with SLO attainment and error budget burn on top.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Service level \u2014 are we keeping the promise?",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "SLOs in breach",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(slo:error_budget_remaining:ratio <= 0) or vector(0)",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Zero means every error budget still has room. Read this first; if it is zero the signals below are informational, not urgent.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Error budget remaining",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "clamp_min(slo:error_budget_remaining:ratio, -1)",
          "range": false,
          "instant": true,
          "refId": "A",
          "legendFormat": "{{sli}} {{service_name}}{{namespace}}"
        }
      ],
      "description": "One tile per SLO. Saturates at -100%: past that the budget is gone and burn rate is the number that matters.\n\nRead the value, not only the colour \u2014 green vs orange is near-indistinguishable under protanopia, so the signed percentage carries the meaning.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 0.0001
              },
              {
                "color": "#0ca30c",
                "value": 0.25
              }
            ]
          },
          "decimals": 0,
          "noValue": "no traffic",
          "min": -1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate (1h)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "slo:burn_rate:ratio_rate1h",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{sli}} {{namespace}}"
        }
      ],
      "description": "Multiples of sustainable budget spend. 1x exhausts the budget exactly at the window's end; 14.4x is the fast-burn page threshold.\n\nsymlog axis: a real incident reaches 80x+, which on a linear axis flattens the 1x and 14.4x decision lines into the baseline.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "symlog",
              "log": 10,
              "linearThreshold": 1
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "R \u2014 Rate  \u00b7  how much work is arriving",
      "collapsed": false,
      "id": 5,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Cluster request rate",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(service_requests{service_name=\"frontend\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "description": "All Frontend gRPC calls, long-polls included \u2014 this is traffic, and a Worker polling IS traffic. A sudden drop here with no error rise usually means callers stopped, not that you broke.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "timeseries",
      "title": "Frontend request rate by operation",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "topk(6, sum by (operation) (rate(service_requests{service_name=\"frontend\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{operation}}"
        }
      ],
      "description": "Top 6 operations. PollWorkflowTaskQueue and PollActivityTaskQueue normally dominate \u2014 that is Workers waiting for work, not load. Watch the shape of StartWorkflowExecution for real demand.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Workflow throughput",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(service_requests{service_name=\"frontend\", operation=\"StartWorkflowExecution\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "started"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(workflow_success{namespace!~\"temporal_system|system|_unknown_\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "completed"
        }
      ],
      "description": "Started vs completed. A persistent gap means work is accumulating \u2014 the single clearest early sign of a saturated Worker fleet, and it shows up here long before anything errors.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "E \u2014 Errors  \u00b7  what is failing, and whose fault is it",
      "collapsed": false,
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Frontend error ratio",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  sum(rate(service_error_with_type{service_name=\"frontend\", error_type!~\"serviceerror_(Canceled|NotFound|NamespaceNotFound|AlreadyExist.*|InvalidArgument|FailedPrecondition|WorkflowExecutionAlreadyStarted|QueryFailed)\"}[$__rate_interval]))\n  or sum(rate(service_requests{service_name=\"frontend\"}[$__rate_interval])) * 0\n)\n/ clamp_min(sum(rate(service_requests{service_name=\"frontend\"}[$__rate_interval])), 0.001)",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "description": "Server-fault ratio. Client-caused errors (Canceled, NotFound, InvalidArgument) are excluded \u2014 counting them measures your callers' behaviour, not your availability.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 0.001
              },
              {
                "color": "#d03b3b",
                "value": 0.01
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "timeseries",
      "title": "Server-fault rate by type",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (error_type) (rate(service_error_with_type{error_type!~\"serviceerror_(Canceled|NotFound|NamespaceNotFound|AlreadyExist.*|InvalidArgument|FailedPrecondition|WorkflowExecutionAlreadyStarted|QueryFailed)\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{error_type}}"
        }
      ],
      "description": "Faults that are yours. ResourceExhausted points at rate limiting or datastore pressure; Internal/Unavailable points at cluster health. Empty here on a healthy cluster is correct, not broken.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Workflow outcomes",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(workflow_success{namespace!~\"temporal_system|system|_unknown_\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "success"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(workflow_failed{namespace!~\"temporal_system|system|_unknown_\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "failed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(workflow_timeout{namespace!~\"temporal_system|system|_unknown_\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "C",
          "legendFormat": "timeout"
        }
      ],
      "description": "The application signal, not the cluster signal. Activity failures absorbed by retries are HEALTHY and do not appear here.\n\nWatch timeout specifically: a saturated fleet produces timeouts, not failures. Measured under a backlog storm, failed sat at 0.02/s while timeout hit 24.6/s.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "timeout"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ec835a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "D \u2014 Duration  \u00b7  how long it takes",
      "collapsed": false,
      "id": 13,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Frontend latency (long-polls excluded)",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(service_latency_bucket{service_name=\"frontend\", operation!~\"Poll.*|GetTaskQueueUserData|ListNexusEndpoints\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(service_latency_bucket{service_name=\"frontend\", operation!~\"Poll.*|GetTaskQueueUserData|ListNexusEndpoints\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(service_latency_bucket{service_name=\"frontend\", operation!~\"Poll.*|GetTaskQueueUserData|ListNexusEndpoints\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "description": "Long-poll operations are EXCLUDED. They block up to 60s by design and are the highest-volume Frontend calls; including them makes this panel measure Worker idle time. Measured: 95.9% under 500ms with polls in, 100% with them out.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9ec5f4"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5598e7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Persistence P95 by operation",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
