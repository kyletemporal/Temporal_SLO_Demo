{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Error budgets and burn rates for every Temporal service role. Compliance window is 1 hour so a chaos scenario visibly drains the budget \u2014 production would use 28-30 days.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Error Budget \u2014 compliance window 1h",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "SLOs in breach",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(slo:error_budget_remaining:ratio <= 0) or vector(0)",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "How many SLOs have fully spent their error budget. The one number to read first: zero means the wall is green and you can stop looking. Above zero is an error budget policy conversation, which is not automatically an incident \u2014 the budget exists to be spent.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Error budget wall",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 19,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "clamp_min(slo:error_budget_remaining:ratio, -1)",
          "range": false,
          "instant": true,
          "refId": "A",
          "legendFormat": "{{sli}} {{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 0.0001
              },
              {
                "color": "#0ca30c",
                "value": 0.25
              }
            ]
          },
          "min": -1,
          "max": 1,
          "decimals": 1,
          "noValue": "no traffic"
        },
        "overrides": []
      },
      "description": "One tile per SLO, coloured by error budget remaining. Healthy is a wall of green; a single tile changing colour is the whole point.\n\nGREEN  >25% of the budget left\nORANGE 0-25% left \u2014 at risk, still meeting the SLO\nRED    budget spent; the SLO has been MISSED for this window\n\nSaturates at -100%: on a 1h window a bad scenario can burn many times the budget, and -7485% is noise. Once a tile is red the budget is gone; the burn rate panel tells you how fast and whether it is still happening.\n\nRead the number, not just the colour: green vs orange is close to indistinguishable for red-green colourblind viewers (protan \u0394E 5.6), so the signed percentage is the reliable channel. Negative means breached.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true,
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "title": "SLO Board \u2014 every Temporal service role",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 4,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "SLO board",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "slo:objective_expanded:ratio",
          "range": false,
          "instant": true,
          "refId": "A",
          "legendFormat": "Objective"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "slo:sli_good:ratio",
          "range": false,
          "instant": true,
          "refId": "B",
          "legendFormat": "Attained"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "clamp_min(slo:error_budget_remaining:ratio, -1)",
          "range": false,
          "instant": true,
          "refId": "C",
          "legendFormat": "Budget left"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "slo:burn_rate:ratio_rate1h",
          "range": false,
          "instant": true,
          "refId": "D",
          "legendFormat": "Burn rate (1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Burn rate (1h)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#0ca30c",
                      "value": null
                    },
                    {
                      "color": "#ec835a",
                      "value": 1
                    },
                    {
                      "color": "#d03b3b",
                      "value": 14.4
                    }
                  ]
                }
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Budget left"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#d03b3b",
                      "value": null
                    },
                    {
                      "color": "#ec835a",
                      "value": 0.0001
                    },
                    {
                      "color": "#0ca30c",
                      "value": 0.25
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attained"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Objective"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service role"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "\u2014",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "\u2014",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLI"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          }
        ]
      },
      "description": "One row per SLO. Objective is the promise; Attained is what actually happened over the compliance window; Budget left is how much room remains; Burn rate is how fast it is being consumed right now (1.0 = exactly on pace to run out at the end of the window).",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "pattern": "^(Time|__name__)$"
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "sli": "SLI",
              "service_name": "Service role",
              "slo:objective_expanded:ratio": "Objective",
              "slo:sli_good:ratio": "Attained",
              "Value": "Budget left",
              "slo:error_budget_remaining:ratio": "Budget left",
              "slo:burn_rate:ratio_rate1h": "Burn rate (1h)"
            },
            "indexByName": {
              "sli": 0,
              "service_name": 1,
              "slo:objective_expanded:ratio": 2,
              "slo:sli_good:ratio": 3,
              "Value": 4,
              "slo:error_budget_remaining:ratio": 4,
              "slo:burn_rate:ratio_rate1h": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Budget left",
                "desc": false
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "type": "row",
      "title": "Burn rate",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 6,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Error budget burn rate (1h window)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "slo:burn_rate:ratio_rate1h",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{sli}} {{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "scaleDistribution": {
              "type": "symlog",
              "log": 10,
              "linearThreshold": 1
            }
          }
        },
        "overrides": []
      },
      "description": "Multiples of sustainable budget consumption. 1.0 exhausts the budget exactly at the end of the window. 14.4 exhausts it in about 2 hours of a 30-day window \u2014 the standard fast-burn paging threshold. Below 1.0 you are spending less than you are allowed.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Fast-burn detector (5m vs 1h)",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "slo:burn_rate:ratio_rate5m",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "5m \u2014 {{sli}} {{service_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "slo:burn_rate:ratio_rate1h",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "1h \u2014 {{sli}} {{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "scaleDistribution": {
              "type": "symlog",
              "log": 10,
              "linearThreshold": 1
            }
          }
        },
        "overrides": []
      },
      "description": "SLOFastBurn pages only when BOTH windows exceed 14.4. The long window proves the burn is real; the short window proves it is still happening, so the alert clears promptly instead of hanging around for an hour after the incident ends.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Per Temporal service role",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 9,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request availability \u2014 frontend / history / matching",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "1 - slo:sli_bad:ratio_rate5m{sli=~\".*_availability\", sli!=\"persistence_availability\"}",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{sli}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "description": "Only these three roles serve gRPC traffic, so only they have a request-based availability SLI. Client-caused errors (Canceled, NotFound, InvalidArgument) are excluded \u2014 counting them measures caller behaviour, not service health.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Persistence availability \u2014 all roles incl. worker & server",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "1 - slo:sli_bad:ratio_rate5m{sli=\"persistence_availability\"}",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "description": "The worker and server roles serve no gRPC traffic of their own, so persistence is how they get an SLO at all. Every role talks to the datastore, which also makes this the SLI that most often explains a latency breach elsewhere.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latency SLIs \u2014 served under 500ms (long-polls excluded)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "1 - slo:sli_bad:ratio_rate5m{sli=~\".*_latency\"}",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{sli}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "description": "PollWorkflowTaskQueue and PollActivityTaskQueue are excluded. They block for up to 60s by design and are the highest-volume operations on the Frontend, so including them makes this panel a measure of how long Workers sit idle rather than how fast the service is.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Worker fleet & application SLIs",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "1 - slo:sli_bad:ratio_rate5m{sli=\"worker_task_delivery\"}",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "Activity Tasks started within 200ms"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "1 - slo:sli_bad:ratio_rate5m{sli=\"workflow_completion\"}",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "Workflows completing successfully"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "description": "worker_task_delivery is an SDK metric and disappears entirely when the Worker fleet is down \u2014 see TemporalWorkerFleetAbsent. workflow_completion comes from the history service, so it keeps reporting through a total Worker outage.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
