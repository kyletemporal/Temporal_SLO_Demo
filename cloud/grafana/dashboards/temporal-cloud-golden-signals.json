      "description": "End-to-end Workflow duration by type. The closest thing to what your customer experiences.\n\nRising here with flat service latency means your Workers or your dependencies, not Temporal.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
