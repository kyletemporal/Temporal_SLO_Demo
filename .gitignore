# Fetched from temporalio/dashboards by `make dashboards` — third-party, not ours to vendor
demo/grafana/dashboards/community/*.json

# Build artefacts
*.tar.gz
__pycache__/
*.pyc

# OS
.DS_Store
app-team/configured/

# Terraform artefacts, at ANY depth.
#
# These patterns were previously only in terraform/.gitignore, which does not
# cover aws/terraform/ — and a 776 MB provider binary was committed and rejected
# by GitHub's 100 MB limit as a result. Scope gitignore rules to the repo, not to
# the directory you happened to be working in.
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Secrets. See SECURITY.md D3 and P3.
#
# .env is ignored because .env.example invites creating one, and the moment
# this stack is pointed at a real cluster that file is where the API key goes.
# The example itself stays tracked — it holds image version pins only.
.env
.env.*
!.env.example

# .tfvars is where per-environment values live, which in practice is where
# secrets land. Ignored by default and re-included only for the worked examples
# that are meant to be read — those hold environment names, regions, search
# attributes and tags, and no credentials.
*.tfvars
*.auto.tfvars
*.tfvars.json
!terraform/patterns/01-environment-promotion/envs/dev.tfvars
!terraform/patterns/01-environment-promotion/envs/prod.tfvars
