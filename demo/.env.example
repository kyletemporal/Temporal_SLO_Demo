# Copy to .env to pin versions, or export inline:
#   TEMPORAL_VERSION=1.27.4 ./deploy.sh --clean
#
# CHANGING ANY VERSION REQUIRES ./deploy.sh --clean. The schema is written at
# first boot and is version-specific.

# ---------------------------------------------------------------------------
# Temporal Service
# ---------------------------------------------------------------------------
# Default 1.27.4. Verified working tags: 1.26.2 1.27.0 1.27.1 1.27.2 1.27.3
# 1.27.4 1.28.4 1.29.7
#
# CEILING: the auto-setup image STOPS AT 1.29.7. There is no auto-setup:1.30,
# 1.31 or later — that image line was discontinued. The OSS server itself is at
# 1.31.2, but running it means dropping auto-setup for temporalio/server plus
# temporalio/admin-tools doing schema setup, which is a different compose
# topology (and the shape you should use in production anyway).
#
# WHAT YOU GIVE UP BELOW 1.30: the TemporalReportedProblems search attribute,
# introduced in 1.30, is the definitive stuck-workflow signal. On 1.29.7 and
# below it does not exist, and stuck detection must fall back to
# workflow_task_execution_failed plus the age ladder. See monitor/DESIGN.md §2.
TEMPORAL_VERSION=1.27.4

# The UI is tolerant of server version, so newest is usually fine.
TEMPORAL_UI_VERSION=2.53.3

# ---------------------------------------------------------------------------
# Observability stack
# ---------------------------------------------------------------------------
PROMETHEUS_VERSION=v3.1.0
GRAFANA_VERSION=11.5.1

# ---------------------------------------------------------------------------
# Supporting
# ---------------------------------------------------------------------------
POSTGRES_VERSION=16-alpine
K6_VERSION=0.55.0
